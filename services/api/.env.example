# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=makemerich
POSTGRES_USER=makemerich
POSTGRES_PASSWORD=makemerich_dev

# Redis
REDIS_URL=redis://localhost:6379/0

# Broker API — Angel One SmartAPI (set your real keys)
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_PIN=
ANGEL_ONE_TOTP_SECRET=

# Broker API — FYERS (optional, for failover)
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=

# LLM Provider Configuration
# Set ACTIVE_LLM_PROVIDER to 'openai', 'gemini', or 'anthropic'
ACTIVE_LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# App settings
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change_this_in_production

# AWS / S3 Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=makemerich-datalake-prod
